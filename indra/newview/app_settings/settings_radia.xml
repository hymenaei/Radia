<?xml version="1.0"?>
<llsd xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="llsd.xsd">
    <map>
        <key>RduiLanguage</key>
        <map>
            <key>Comment</key>
            <string>Selected Radia UI language. Empty uses the localization catalog default.</string>
            <key>Persist</key>
            <integer>1</integer>
            <key>Type</key>
            <string>String</string>
            <key>Value</key>
            <string></string>
        </map>
        <key>RduiAuthoringMode</key>
        <map>
            <key>Comment</key>
            <string>Enable automatic transactional reload of settled Radia skin resource changes.</string>
            <key>Persist</key>
            <integer>1</integer>
            <key>Type</key>
            <string>Boolean</string>
            <key>Value</key>
            <integer>0</integer>
        </map>
        <key>RduiFloaterPlacements</key>
        <map>
            <key>Comment</key>
            <string>Radia UI Floater attachment state and logical or native monitor placement.</string>
            <key>Persist</key>
            <integer>1</integer>
            <key>Type</key>
            <string>LLSD</string>
            <key>Value</key>
            <map />
        </map>
        <key>RduiOpenFloaters</key>
        <map>
            <key>Comment</key>
            <string>Radia UI Floater definitions and instance keys that reopen after login.</string>
            <key>Persist</key>
            <integer>1</integer>
            <key>Type</key>
            <string>LLSD</string>
            <key>Value</key>
            <array>
                <map>
                    <key>definition</key>
                    <string>floater-demo</string>
                    <key>instance</key>
                    <string></string>
                </map>
            </array>
        </map>
    </map>
</llsd>
