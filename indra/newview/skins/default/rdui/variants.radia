button.compact {
    size: 32px;
    padding: 4px;
}

field.switch {
    gap: 8px;

    > label { flex-grow: 1; }
}

text#language-heading {
    text-color: var(--muted);
}

text#active-language {
    font-weight: bold;
}

panel#language-buttons {
    flow: row;
    gap: 8px;
}

button.language {
    flex: 1;
}
