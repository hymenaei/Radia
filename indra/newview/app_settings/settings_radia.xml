<?xml version="1.0"?>
<llsd xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="llsd.xsd">
    <map>
        <key>Locale</key>
        <map>
            <key>Comment</key>
            <string>Selected UI locale. Empty uses the localization catalog default.</string>
            <key>Persist</key>
            <integer>1</integer>
            <key>Type</key>
            <string>String</string>
            <key>Value</key>
            <string></string>
        </map>
        <key>LongClickDelay</key>
        <map>
            <key>Comment</key>
            <string>Default held-click duration for Radia UI widgets, in milliseconds. Values below 1 are clamped.</string>
            <key>Persist</key>
            <integer>1</integer>
            <key>Type</key>
            <string>S32</string>
            <key>Value</key>
            <integer>500</integer>
        </map>
        <key>SkinAutoReload</key>
        <map>
            <key>Comment</key>
            <string>Enable automatic transactional reload of settled Skin resource changes.</string>
            <key>Persist</key>
            <integer>1</integer>
            <key>Type</key>
            <string>Boolean</string>
            <key>Value</key>
            <integer>0</integer>
        </map>
        <key>SkinAutoReloadScanInterval</key>
        <map>
            <key>Comment</key>
            <string>Time between automatic Radia Skin snapshot checks, in milliseconds. Values below 1 are clamped.</string>
            <key>Persist</key>
            <integer>1</integer>
            <key>Type</key>
            <string>S32</string>
            <key>Value</key>
            <integer>250</integer>
        </map>
        <key>SkinAutoReloadSettleInterval</key>
        <map>
            <key>Comment</key>
            <string>Time a changed Radia Skin snapshot must remain stable before reload, in milliseconds. Values below 1 are clamped.</string>
            <key>Persist</key>
            <integer>1</integer>
            <key>Type</key>
            <string>S32</string>
            <key>Value</key>
            <integer>150</integer>
        </map>
        <key>DemoSwitch</key>
        <map>
            <key>Comment</key>
            <string>Demo value control used to exercise Radia setting bindings.</string>
            <key>Persist</key>
            <integer>1</integer>
            <key>Type</key>
            <string>Boolean</string>
            <key>Value</key>
            <integer>1</integer>
        </map>
        <key>UILayout</key>
        <map>
            <key>Comment</key>
            <string>Stores saved UI layout, including position and size.</string>
            <key>Persist</key>
            <integer>1</integer>
            <key>Type</key>
            <string>LLSD</string>
            <key>Value</key>
            <map>
                <key>floaterDemo</key>
                <map />
            </map>
        </map>
    </map>
</llsd>
