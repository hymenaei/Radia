button.compact {
    size: 32px;
    padding: 4px;
}

field.switch {
    gap: 8px;

    > label { flex-grow: 1; }
}

text#language-heading {
    text-color: var(--muted);
}

text#active-language {
    font-weight: bold;
}

panel#language-buttons {
    flow: row;
    gap: 8px;
}

button.language {
    flex: 1;
}

panel.demo-property-sections {
    flow: column;
    gap: 16px;
}

panel.demo-section {
    flow: column;
    gap: 6px;
    padding: 8px;
    border: 1px #ffffff24;
}

text.demo-section-heading {
    text-color: var(--muted);
    font-weight: bold;
}

text.demo-font {
    font: italic 525 15px / 21px sans;
}

text.demo-tracking {
    letter-spacing: 8%;
}

text.demo-word-spacing {
    word-spacing: 4px;
}

text.demo-wrap {
    text-wrap: wrap;
    padding: 4px;
    background-color: #ffffff0c;
    border-radius: 4px;
}

text.demo-ellipsis-end, text.demo-ellipsis-center {
    height: 22px;
    text-wrap: nowrap;
    overflow: hidden;
    padding: 2px 4px;
    background-color: #ffffff0c;
    border: 1px #ffffff18;
    border-radius: 4px;
}

text.demo-ellipsis-end {
    text-overflow: ellipsis;
}

text.demo-ellipsis-center {
    text-overflow: ellipsis-center;
}

text.demo-outline {
    padding: 4px;
    background-color: #ffffff0c;
    border: 1px #ffffff24;
    border-radius: 4px;
    outline: 2px 2px dashed var(--accent);
}

panel.demo-overflow-row {
    flow: row;
    gap: 8px;
}

panel.demo-overflow-x, panel.demo-overflow-y {
    height: 26px;
    flex: 1;
    background-color: #ffffff0c;
    border: 1px #ffffff24;
}

panel.demo-overflow-x {
    overflow-x: hidden;
    overflow-y: visible;

    > text {
        text-wrap: nowrap;
    }
}

panel.demo-overflow-y {
    flow: column;
    overflow: visible hidden;

    > text {
        text-wrap: wrap;
    }
}
