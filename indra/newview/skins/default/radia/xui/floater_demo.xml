<?xml version="1.0" encoding="utf-8"?>
<floater id="floaterDemo"
         title="demo.title"
         icon="search"
         canMinimize="true"
         canResize="true">

    <p id="status">demo.status</p>

    <p>demo.inlineContent</p>

    <div class="demo-property-sections">
        <div class="demo-section demo-text-properties">
            <p class="demo-section-heading">demo.textProperties</p>

            <p class="demo-font">demo.fontShorthand</p>
            <p class="demo-tracking">demo.letterSpacing</p>
            <p class="demo-word-spacing">demo.wordSpacing</p>
            <p class="demo-wrap">demo.wrapping</p>

            <p class="demo-ellipsis-end">demo.ellipsisEndInventory</p>
            <p class="demo-ellipsis-center">demo.ellipsisCenterInventory</p>
        </div>

        <div class="demo-section demo-box-properties">
            <p class="demo-section-heading">demo.boxProperties</p>

            <p class="demo-outline">demo.outline</p>

            <div class="demo-overflow-row">
                <div class="demo-overflow-x">
                    <p>demo.overflowX</p>
                </div>
                <div class="demo-overflow-y">
                    <p>demo.overflowY</p>
                </div>
            </div>
        </div>
    </div>

    <button class="primary" onClick="press()">
        <icon src="search"/>
        demo.press
    </button>

    <fieldset class="demo-settings">
        <legend>demo.settings</legend>

        <field class="switch demo-setting">
            <label for="demoSwitch">demo.switch</label>
            <switch id="demoSwitch" setting="DemoSwitch" onChange="switchChanged(event)"/><br/>
            <hint>demo.switchHint</hint><br/>
            <error>demo.switchError</error>
        </field>

        <field class="switch control-first">
            <switch id="skinAutoReloadToggle" setting="SkinAutoReload"/>
            <label for="skinAutoReloadToggle">demo.automaticWatching</label><br/>
            <hint>demo.automaticWatchingHint</hint><br/>
            <error>demo.automaticWatchingError</error>
        </field>
    </fieldset>

    <button class="compact" disabled="true"/>

    <p id="languageHeading">demo.language</p>
    <p id="activeLocale"/>

    <div id="languageButtons">
        <button id="previousLocale" class="language previous" onClick="selectLocale(-1)">demo.previous</button>
        <button id="nextLocale" class="language next" onClick="selectLocale(+1)">demo.next</button>
    </div>

    <button class="reload" onClick="requestSkinReload()">demo.reloadNow</button>
</floater>
