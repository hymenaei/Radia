<?xml version="1.0" encoding="utf-8"?>
<floater id="floater-demo"
         title="demo.title"
         icon="search"
         canMinimize="true"
         canResize="true">

    <text id="status">demo.status</text>

    <text>demo.inlineContent</text>

    <button class="primary" onClick="press">
        <icon source="search"/>
        demo.press
    </button>

    <fieldset class="demo-settings">
        <legend>demo.settings</legend>

        <field class="switch demo-setting">
            <label for="demo-switch">demo.switch</label>
            <switch id="demo-switch" bind="demo-switch-enabled" onChange="switch-changed"/><br/>
            <hint>demo.switchHint</hint><br/>
            <error>demo.switchError</error>
        </field>

        <field class="switch control-first">
            <switch id="authoring-mode" onChange="authoring-mode-changed"/>
            <label for="authoring-mode">demo.automaticWatching</label><br/>
            <hint>demo.automaticWatchingHint</hint><br/>
            <error>demo.automaticWatchingError</error>
        </field>
    </fieldset>

    <button class="compact" disabled="true"/>

    <text id="language-heading">demo.language</text>
    <text id="active-language"/>

    <panel id="language-buttons">
        <button id="previous-language" class="language previous" onClick="previous-language">demo.previous</button>
        <button id="next-language" class="language next" onClick="next-language">demo.next</button>
    </panel>

    <button class="reload" onClick="reload-resources">demo.reloadNow</button>
</floater>
