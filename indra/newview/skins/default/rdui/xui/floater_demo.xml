<?xml version="1.0" encoding="utf-8"?>
<floater id="floater-demo"
         title="floater_demo.title"
         icon="search"
         canMinimize="true"
         canResize="true">

    <label id="status">floater_demo.status</label>

    <button class="primary" onClick="press">
        <icon source="search"/>
        floater_demo.press
    </button>

    <field class="switch-demo">
        <label>floater_demo.switch</label>
        <switch checked="true" onChange="switch-changed"/>
    </field>

    <button class="compact" disabled="true"/>

    <label id="language-heading">floater_demo.language</label>
    <label id="active-language"/>

    <field id="language-buttons">
        <button id="previous-language" class="language previous" onClick="previous-language">floater_demo.previous</button>
        <button id="next-language" class="language next" onClick="next-language">floater_demo.next</button>
    </field>

    <button class="reload" onClick="reload-resources">floater_demo.reload_now</button>

    <field class="authoring">
        <content><label>floater_demo.automatic_watching</label></content>
        <switch id="authoring-mode" onChange="authoring-mode-changed"/>
    </field>
</floater>
