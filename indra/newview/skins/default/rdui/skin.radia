@import "variants.radia";

:root {
    --panel: #151922e8;
    --panel-border: #333333;
    --surface: #242c38f2;
    --surface-hover: #2e3a49f8;
    --surface-active: #18202df8;
    --accent: #efff62e8;
    --accent-dark: #907e2fff;
    --text: #edf6ffff;
    --muted: #a7b8c6ff;
    --focus: #ffffffcc;
    --radius-md: 6px;
    --radius-lg: 12px;
}

floater {
    size: auto 292px;
    min-size: 300px 292px;
    flow: column;
    background-color: #1f1f1fe5;
    effect: background-blur(64px);
    border-radius: var(--radius-lg);
    border: 1px var(--panel-border);

    &:minimized::header { border-width: 0px; }
    &:minimized { width: auto; }

    &::header {
        height: 48px;
        border-color: var(--panel-border);
        border-width: 0px 0px 1px;
        flow: row;
        gap: 6px;
        padding: 12px;

        &::icon {
            size: 28px;
            stroke: 2px var(--accent);
        }

        &::title {
            text-color: var(--text);
            font-family: sans;
            font-size: 13px;
            line-height: 18px;
        }

        &::custom {
            height: 24px;
            flow: row;
            grow: 1;
            gap: 6px;
        }

        &::close, &::minimize {
            cursor: pointer;
            size: 24px;
            background-color: #ffffff14;
            border-radius: 6px;
            border: 1px #ffffff24;
            flow: row;
            justify-content: center;

            &:hover { background-color: #ffffff28; border-color: #ffffff40; }
            &:active { background-color: #0000003c; border-color: #ffffff18; }
            &:focus-visible { border-color: var(--focus); border-width: 2px; }

            &::icon {
                size: 16px;
                stroke: 1px var(--text);
            }
        }
    }

    &::content {
        flow: column;
        margin: 8px;
        gap: 8px;
    }
}

label {
    text-color: var(--text);
    font-family: sans;
    font-size: 13px;
    line-height: 18px;
    vertical-align: middle;
}

button {
    cursor: pointer;
    height: 32px;
    background-color: var(--surface);
    border-radius: var(--radius-md);
    border: 1px #ffffff24;
    flow: row;
    justify-content: center;
    gap: 6px;
    padding: 9px;
    text-color: var(--text);
    font-family: sans;
    font-size: 13px;
    line-height: 18px;

    &:hover { background-color: var(--surface-hover); }
    &:active { background-color: var(--surface-active); }
    &:focus-visible { border-color: var(--focus); border-width: 2px; }
    &:disabled { opacity: 0.55; cursor: default; }

    > icon {
        size: 16px;
        stroke: 1px var(--accent);
    }
}

switch {
    cursor: pointer;
    size: 32px 64px;
    padding: 4px;
    background-color: #1a2230ff;
    border-radius: 14px;
    border: 1px #ffffff2f;

    &::thumb {
        background-color: #d8e6f2ff;
        border-radius: 10px;
        border: 1px #ffffffff;
    }

    &:checked { background-color: var(--accent-dark); border-color: var(--accent); }
    &:checked::thumb { background-color: #ffffffff; border-color: #dff9ffff; }
    &:focus-visible { border-color: var(--focus); border-width: 2px; }
}
