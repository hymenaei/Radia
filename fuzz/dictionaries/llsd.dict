# LLSD XML elements recognized by xml::tag_name and binary attribute handling.
"<?xml version=\"1.0\" ?>"
"<llsd>"
"</llsd>"
"<map>"
"</map>"
"<array>"
"</array>"
"<key>"
"</key>"
"<undef/>"
"<boolean>"
"</boolean>"
"<integer>"
"</integer>"
"<real>"
"</real>"
"<uuid>"
"</uuid>"
"<string>"
"</string>"
"<uri>"
"</uri>"
"<date>"
"</date>"
"<binary>"
"</binary>"
"encoding=\"base64\""
"<![CDATA["
"]]>"
"&amp;"
"&#13;"
"&#60;"
"&#x42;"

# LLSD notation document marker, delimiters, scalar markers, and binary encodings.
"<?llsd/notation?>"
"{"
"}"
"["
"]"
":"
","
"!"
"'"
"\""
"i"
"r"
"u"
"s"
"d"
"l"
"b"
"b("
"b16"
"b64"
"true"
"false"
"\\n"
"\\r"
"\\t"
"\\x"
"\\u"
"\\U"
"nan"
"inf"
"-inf"
"infinity"

# LLSD binary document marker; value markers are shared with notation above.
"<?llsd/binary?>"
"0"
"1"
